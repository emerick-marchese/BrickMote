# /etc/systemd/system/brickmote-relay.service
# Installation :
#   sudo python3 -m venv /opt/brickmote/venv
#   sudo /opt/brickmote/venv/bin/pip install cryptography
#   sudo cp -r brickmote /opt/brickmote/
#   sudo systemctl enable --now brickmote-relay
#   journalctl -u brickmote-relay   # affiche l'empreinte du certificat
[Unit]
Description=BrickMote relay server
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/brickmote
ExecStart=/opt/brickmote/venv/bin/python -m brickmote.server --data-dir /var/lib/brickmote-relay --ports 6568,443,80
DynamicUser=yes
StateDirectory=brickmote-relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
